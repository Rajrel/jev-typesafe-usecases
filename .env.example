# Copy this file to .env and fill in your keys. Do not commit .env.

# Jev / TypeSafe — required for every decision cell.
TYPESAFE_API_KEY=

# The host only. The client adds /v1/systemone itself, so do NOT include /v1 here.
# Leave blank to use the default: https://api.typesafe.ai
TYPESAFE_BASE_URL=

# Model id. jev-latest follows the current release.
# Use jev-1.13.0 to pin an exact version.
JEV_MODEL=jev-latest

# OpenAI — only needed for the three cells marked "needs OpenAI".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
